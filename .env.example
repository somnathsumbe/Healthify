# Copy to .env on the push server only. Never commit real values.
PORT=8787
NODE_ENV=production
DATA_FILE=./push-service/data/push-state.json
PUSH_API_TOKEN=replace-with-a-long-random-token
VAPID_PUBLIC_KEY=replace-with-web-push-public-key
VAPID_PRIVATE_KEY=replace-with-web-push-private-key
VAPID_SUBJECT=mailto:admin@example.com
ALLOWED_ORIGIN=https://somnathsumbe.github.io
